<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>12</LangVersion>
    <AssemblyName>DDLSaver</AssemblyName>
    <RootNamespace>DDLSaver</RootNamespace>
    <ApplicationIcon>Resources\app.ico</ApplicationIcon>
    <AssemblyTitle>DDL拯救器</AssemblyTitle>
    <Product>DDL拯救器</Product>
    <Description>大学生 DDL 拯救器：常驻浮窗 + 到点提醒的极简任务管理工具</Description>
    <Authors>DDLSaver contributors</Authors>
    <Copyright>Copyright © 2024-2026 DDLSaver contributors</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <Version>1.0.0</Version>
    <FileVersion>1.0.0.0</FileVersion>
    <NeutralLanguage>zh-CN</NeutralLanguage>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Hardcodet.NotifyIcon.Wpf" Version="2.0.1" />
    <PackageReference Include="CommunityToolkit.WinUI.Notifications" Version="7.1.2" />
    <PackageReference Include="WPF-UI" Version="4.3.0" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Resources\app.png" />
  </ItemGroup>

</Project>
