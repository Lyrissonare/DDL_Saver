<ui:FluentWindow x:Class="DDLSaver.Windows.TaskEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="任务编辑"
        Width="660" Height="820" MinHeight="720"
        WindowStartupLocation="CenterOwner"
        WindowBackdropType="Mica"
        WindowCornerPreference="Round"
        ExtendsContentIntoTitleBar="True"
        FontFamily="Segoe UI Variable Text, Microsoft YaHei UI, Microsoft YaHei, Segoe UI"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Foreground="{DynamicResource TextPrimaryBrush}"
        Background="{DynamicResource AppBgBrush}">
    <ui:FluentWindow.Resources>
        <Style x:Key="FieldBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style x:Key="QuickTimeButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Margin" Value="4,0" />
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0"
                     Title="{Binding Title, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                     Icon="{ui:ImageIcon 'pack://application:,,,/Resources/app.png'}"
                     Height="46" Padding="14,0,0,0" FontSize="12.5"
                     ShowMinimize="False" ShowMaximize="False" />

        <Grid Grid.Row="1" Margin="16,8,16,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 标题 / 分类 / 截止 -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="70" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource FieldLabel}" Text="标题 *" />
                <TextBox x:Name="TitleBox" Grid.Column="1" Style="{StaticResource FieldBox}" MaxLength="200" />
            </Grid>

            <Grid Grid.Row="1" Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="70" />
                    <ColumnDefinition Width="120" />
                    <ColumnDefinition Width="90" />
                    <ColumnDefinition Width="168" />
                    <ColumnDefinition Width="80" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource FieldLabel}" Text="分类" />
                <ComboBox x:Name="CategoryCombo" Grid.Column="1" />
                <TextBlock Grid.Column="2" Style="{StaticResource FieldLabel}" Text="截止日期 *" />
                <DatePicker x:Name="DeadlineDatePicker" Grid.Column="3" />
                <TextBlock Grid.Column="4" Style="{StaticResource FieldLabel}" Text="时间" />
                <TextBox x:Name="DeadlineTimeBox" Grid.Column="5" Style="{StaticResource FieldBox}" Width="90" HorizontalAlignment="Left" />
            </Grid>

            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="80,4,0,0">
                <TextBlock FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Text="快捷时间：" VerticalAlignment="Center" />
                <Button Style="{StaticResource QuickTimeButton}" Content="09:00" Click="OnQuickTime" Tag="09:00" />
                <Button Style="{StaticResource QuickTimeButton}" Content="12:00" Click="OnQuickTime" Tag="12:00" />
                <Button Style="{StaticResource QuickTimeButton}" Content="18:30" Click="OnQuickTime" Tag="18:30" />
                <Button Style="{StaticResource QuickTimeButton}" Content="23:59" Click="OnQuickTime" Tag="23:59" />
            </StackPanel>

            <!-- 进度 -->
            <Grid Grid.Row="3" Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="70" />
                    <ColumnDefinition Width="90" />
                    <ColumnDefinition Width="90" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="90" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource FieldLabel}" Text="进度" />
                <TextBlock Grid.Column="1" Text="总量" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" />
                <TextBox x:Name="TotalBox" Grid.Column="2" Style="{StaticResource FieldBox}" ToolTip="留空表示无进度" />
                <TextBlock Grid.Column="3" Text="已完成" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" Margin="12,0,0,0" />
                <TextBox x:Name="DoneBox" Grid.Column="4" Style="{StaticResource FieldBox}" ToolTip="已完成数量" />
                <StackPanel Grid.Column="5" Orientation="Horizontal" Margin="12,0,0,0">
                    <TextBlock Text="单位" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBox x:Name="UnitBox" Style="{StaticResource FieldBox}" Width="80" ToolTip="如：节 / 章 / 页 / 题" />
                </StackPanel>
            </Grid>

            <!-- 重复 -->
            <Grid Grid.Row="4" Margin="0,10,0,0" VerticalAlignment="Top">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="70" />
                    <ColumnDefinition Width="160" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource FieldLabel}" Text="重复" />
                <ComboBox x:Name="RecurrenceCombo" Grid.Column="1" />
                <TextBlock Grid.Column="2" FontSize="11.5" Foreground="{DynamicResource TextMutedBrush}"
                           Text="完成后自动顺延一个周期生成下一实例（进度与子任务复位）" VerticalAlignment="Center" />
            </Grid>

            <!-- 提醒方案 -->
            <GroupBox Grid.Row="5" Header="提醒方案" Margin="0,10,0,0">
                <StackPanel>
                    <WrapPanel>
                        <CheckBox x:Name="Rem7dCheck" Content="截止前 7 天提醒一次" Margin="0,0,18,6" />
                        <CheckBox x:Name="RemDailyCheck" Content="前 3 天起每天提醒" Margin="0,0,18,6" />
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,6">
                            <CheckBox x:Name="Rem24hCheck" Content="≤24 小时每" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <ComboBox x:Name="FreqHoursCombo" Width="92" VerticalAlignment="Center" />
                            <TextBlock Text="小时提醒一次" VerticalAlignment="Center" Margin="4,0,0,0"
                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                        </StackPanel>
                    </WrapPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0" VerticalAlignment="Center">
                        <TextBlock Text="每日提醒时间：" FontSize="12.5" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                        <TextBox x:Name="DailyTimeBox" Width="72" />
                        <TextBlock Text="（逾期后每天提醒一次，直到完成或删除）" FontSize="11.5" Margin="8,0,0,0" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextMutedBrush}" />
                    </StackPanel>
                </StackPanel>
            </GroupBox>

            <!-- 子任务 -->
            <GroupBox Grid.Row="6" Header="子任务清单（小组分工：张三-PPT）" Margin="0,10,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="200">
                        <ItemsControl x:Name="SubTaskList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="36" />
                                            <ColumnDefinition Width="150" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="40" />
                                        </Grid.ColumnDefinitions>
                                        <CheckBox Grid.Column="0" IsChecked="{Binding IsDone, Mode=TwoWay}" VerticalAlignment="Center" />
                                        <TextBox Grid.Column="1" Text="{Binding Title, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 ToolTip="子任务标题" />
                                        <TextBox Grid.Column="2" Text="{Binding Note, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 Margin="6,0" ToolTip="备注（可选）" />
                                        <Button Grid.Column="3" Content="✕" Padding="0" Click="OnRemoveSubTask" Tag="{Binding}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <Button Grid.Row="1" Content="＋ 添加子任务" Margin="0,8,0,0" HorizontalAlignment="Left" Click="OnAddSubTask" />
                </Grid>
            </GroupBox>

            <!-- 备注 -->
            <Grid Grid.Row="7" Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="70" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource FieldLabel}" Text="备注" />
                <TextBox x:Name="NoteBox" Grid.Column="1" Height="56" TextWrapping="Wrap"
                         AcceptsReturn="True" VerticalScrollBarVisibility="Auto" />
            </Grid>

            <!-- 按钮 -->
            <StackPanel Grid.Row="8" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                <ui:Button Content="保存" Width="96" Margin="0,0,10,0" Appearance="Primary" IsDefault="True" Click="OnSave" />
                <ui:Button Content="取消" Width="96" IsCancel="True" />
            </StackPanel>
        </Grid>
    </Grid>
</ui:FluentWindow>
