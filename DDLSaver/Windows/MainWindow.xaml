<ui:FluentWindow x:Class="DDLSaver.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="DDL拯救器"
        Width="960" Height="680" MinWidth="760" MinHeight="500"
        WindowStartupLocation="CenterScreen"
        WindowBackdropType="Mica"
        WindowCornerPreference="Round"
        ExtendsContentIntoTitleBar="True"
        FontFamily="Segoe UI Variable Text, Microsoft YaHei UI, Microsoft YaHei, Segoe UI"
        ShowInTaskbar="True"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Foreground="{DynamicResource TextPrimaryBrush}"
        Background="{DynamicResource AppBgBrush}">
    <ui:FluentWindow.Resources>
        <!-- 工具栏按钮（BasedOn Fluent 默认按钮样式） -->
        <Style x:Key="ActionButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <Style x:Key="ToolbarFluentButton" TargetType="{x:Type ui:Button}" BasedOn="{StaticResource {x:Type ui:Button}}">
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="MinHeight" Value="32" />
        </Style>

        <!-- 任务行样式（BasedOn Fluent 默认列表项样式） -->
        <Style x:Key="TaskItem" TargetType="ListViewItem" BasedOn="{StaticResource {x:Type ListViewItem}}">
            <Setter Property="Margin" Value="0,1" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="4" />
            <EventSetter Event="MouseDoubleClick" Handler="OnRowDoubleClick" />
            <Setter Property="ContextMenu">
                <Setter.Value>
                    <ContextMenu>
                        <MenuItem Header="编辑任务" Click="OnMenuEdit" />
                        <MenuItem Header="完成 / 恢复" Click="OnMenuToggleComplete" />
                        <MenuItem Header="删除任务" Click="OnMenuDelete" />
                    </ContextMenu>
                </Setter.Value>
            </Setter>
        </Style>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 标题栏 -->
        <ui:TitleBar x:Name="AppTitleBar" Grid.Row="0"
                     Title="DDL拯救器"
                     Icon="{ui:ImageIcon 'pack://application:,,,/Resources/app.png'}"
                     Height="46" Padding="14,0,0,0" FontSize="12.5"
                     ShowMinimize="True" ShowMaximize="True" ShowClose="True" />

        <!-- 顶部工具栏 -->
        <Border Grid.Row="1" Background="{DynamicResource ToolbarBgBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1"
                Padding="12,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <WrapPanel Grid.Column="0" Orientation="Horizontal">
                    <ui:Button Style="{StaticResource ToolbarFluentButton}" Appearance="Primary"
                               Content="新建任务" Click="OnNewTask" />
                    <Button Style="{StaticResource ActionButton}" Content="快速添加 (Ctrl+Alt+D)" Click="OnQuickAdd" />
                    <Button Style="{StaticResource ActionButton}" Content="编辑" Click="OnEditTask" />
                    <Button Style="{StaticResource ActionButton}" x:Name="ToggleCompleteButton" Content="标记完成" Click="OnToggleComplete" />
                    <Button Style="{StaticResource ActionButton}" Content="删除" Click="OnDeleteTask" />
                </WrapPanel>

                <Button Grid.Column="1" Style="{StaticResource ActionButton}" Content="导入 / 导出  ▾"
                        Margin="8,0,0,0" Click="OnImportExportMenu">
                    <Button.ContextMenu>
                        <ContextMenu x:Name="ImportExportMenu">
                            <MenuItem Header="导出 JSON" Click="OnExportJson" />
                            <MenuItem Header="导出 CSV" Click="OnExportCsv" />
                            <Separator />
                            <MenuItem Header="导入 JSON" Click="OnImportJson" />
                            <MenuItem Header="导入 .ics" Click="OnImportIcs" />
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
            </Grid>
        </Border>

        <!-- 内容页 -->
        <TabControl Grid.Row="2" Margin="12,8,12,0" SelectionChanged="OnTabChanged">
            <!-- ============ 任务管理 ============ -->
            <TabItem Header="任务">
                <ListView x:Name="TaskList"
                          ItemsSource="{Binding}"
                          SelectionMode="Single"
                          BorderThickness="0"
                          Background="Transparent"
                          VirtualizingPanel.ScrollUnit="Pixel"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="4,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="40" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Button Grid.Column="0"
                                        Width="30" Height="30"
                                        Padding="0"
                                        VerticalAlignment="Center"
                                        Cursor="Hand"
                                        Content="{Binding CheckMark}"
                                        Foreground="{Binding CheckColor}"
                                        FontSize="17" FontWeight="Bold"
                                        Background="Transparent" BorderThickness="0"
                                        ToolTipService.ShowDuration="6000"
                                        ToolTip="{Binding CheckToolTip}"
                                        Click="OnToggleComplete" Tag="{Binding Task}" />

                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="4,0,8,0">
                                    <TextBlock Text="{Binding Title}"
                                               FontSize="15"
                                               FontWeight="{Binding TitleWeight}"
                                               Foreground="{Binding UrgencyBrush}"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding MetaLine}"
                                               FontSize="11.5"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>

                                <Border Grid.Column="2"
                                        VerticalAlignment="Center"
                                        CornerRadius="10"
                                        Padding="9,3"
                                        SnapsToDevicePixels="True"
                                        Background="{Binding BadgeBrush}">
                                    <TextBlock Text="{Binding UrgencyName}"
                                               FontSize="11.5"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource BadgeTextBrush}" />
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </TabItem>

            <!-- ============ 统计 ============ -->
            <TabItem Header="统计">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="16">
                        <TextBlock Text="完成打卡统计" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10" />
                        <UniformGrid Columns="5" x:Name="StatCards">
                            <!-- 运行时注入卡片 -->
                        </UniformGrid>

                        <TextBlock Text="最近完成记录" FontSize="15" FontWeight="SemiBold" Margin="0,22,0,8" />
                        <ListBox x:Name="RecentList" MaxHeight="220" BorderThickness="0" Background="Transparent"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="2,2">
                                        <TextBlock Text="{Binding WhenText}" Foreground="{DynamicResource TextSecondaryBrush}" Width="150" />
                                        <TextBlock Text="{Binding Title}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ============ 设置 ============ -->
            <TabItem Header="设置">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="16,4,16,16" MaxWidth="680" HorizontalAlignment="Left">

                        <TextBlock Style="{StaticResource SectionHeader}" Text="浮窗" Margin="0,8,0,6" />
                        <GroupBox Header="浮窗外观与行为">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Text="不透明度" VerticalAlignment="Center" />
                                <DockPanel Grid.Row="0" Grid.Column="1">
                                    <TextBlock x:Name="OpacityLabel" DockPanel.Dock="Right" Width="56" TextAlignment="Right" Foreground="{DynamicResource TextSecondaryBrush}" />
                                    <Slider x:Name="OpacitySlider" Minimum="0.30" Maximum="1.0" Value="0.9"
                                            ValueChanged="OnOpacityChanged" TickFrequency="0.05" IsSnapToTickEnabled="False" />
                                </DockPanel>

                                <TextBlock Grid.Row="1" Text="字号" VerticalAlignment="Center" Margin="0,4,0,0" />
                                <DockPanel Grid.Row="1" Grid.Column="1" Margin="0,4,0,0">
                                    <TextBlock x:Name="FontSizeLabel" DockPanel.Dock="Right" Width="56" TextAlignment="Right" Foreground="{DynamicResource TextSecondaryBrush}" />
                                    <Slider x:Name="FontSizeSlider" Minimum="10" Maximum="28" Value="14"
                                            ValueChanged="OnFontSizeChanged" TickFrequency="1" IsSnapToTickEnabled="True" />
                                </DockPanel>

                                <TextBlock Grid.Row="2" Text="显示条数" VerticalAlignment="Center" Margin="0,4,0,0" />
                                <ComboBox x:Name="CountCombo" Grid.Row="2" Grid.Column="1" Width="120" HorizontalAlignment="Left" Margin="0,4,0,0"
                                          SelectionChanged="OnCountChanged" />

                                <TextBlock Grid.Row="3" Text="位置" VerticalAlignment="Center" Margin="0,4,0,0" />
                                <ComboBox x:Name="DockCombo" Grid.Row="3" Grid.Column="1" Width="160" HorizontalAlignment="Left" Margin="0,4,0,0"
                                          SelectionChanged="OnDockChanged" />

                                <TextBlock Grid.Row="4" Text="显示模式" VerticalAlignment="Center" Margin="0,6,0,0" />
                                <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal" Margin="0,6,0,0">
                                    <RadioButton x:Name="ModeFullRadio" Content="完整浮窗" Checked="OnModeChecked" Margin="0,0,16,0" />
                                    <RadioButton x:Name="ModeMiniRadio" Content="极简模式" Checked="OnModeChecked" Margin="0,0,16,0" />
                                    <RadioButton x:Name="ModeHiddenRadio" Content="完全隐藏" Checked="OnModeChecked" />
                                </StackPanel>
                                <TextBlock x:Name="ModeHintText" Grid.Row="5" Grid.Column="1" FontSize="11" Foreground="{DynamicResource UrgencyMediumBrush}"
                                           TextWrapping="Wrap" Margin="0,2,0,0" />

                                <TextBlock Grid.Row="6" Text="鼠标穿透" VerticalAlignment="Center" Margin="0,6,0,0" />
                                <CheckBox x:Name="MouseThroughCheck" Grid.Row="6" Grid.Column="1"
                                          Content="浮窗只读展示，点击穿透到下层窗口（用托盘操作）"
                                          Margin="0,6,0,0" Checked="OnMouseThroughChanged" Unchecked="OnMouseThroughChanged" />

                                <TextBlock Grid.Row="7" Text="全屏自动隐藏" VerticalAlignment="Center" Margin="0,6,0,0" />
                                <CheckBox x:Name="FullscreenCheck" Grid.Row="7" Grid.Column="1"
                                          Margin="0,6,0,0" Checked="OnFullscreenChanged" Unchecked="OnFullscreenChanged">
                                    <TextBlock TextWrapping="Wrap">检测到全屏应用（游戏/视频/演示）时浮窗降级为极简圆点提示，<LineBreak />退出后恢复原模式</TextBlock>
                                </CheckBox>

                                <TextBlock Grid.Row="8" Text="提示" VerticalAlignment="Center" Margin="0,6,0,0" />
                                <TextBlock Grid.Row="8" Grid.Column="1" FontSize="11.5" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,6,0,0"
                                           Text="存在 24 小时内到期（或已逾期）的任务时，不允许完全隐藏，只能降级为极简模式。" />

                                <TextBlock Grid.Row="9" Text="底色透明度" VerticalAlignment="Center" Margin="0,6,0,0"
                                           ToolTip="浮窗卡片底色的透明程度（0% = 完全透明，只剩文字）" />
                                <DockPanel Grid.Row="9" Grid.Column="1" Margin="0,6,0,0">
                                    <TextBlock x:Name="BgOpacityLabel" DockPanel.Dock="Right" Width="56" TextAlignment="Right" Foreground="{DynamicResource TextSecondaryBrush}" />
                                    <Slider x:Name="BgOpacitySlider" Minimum="0.0" Maximum="1.0" Value="0.94"
                                            ValueChanged="OnFloatBgOpacityChanged" TickFrequency="0.05" IsSnapToTickEnabled="False" />
                                </DockPanel>

                                <TextBlock Grid.Row="10" Text="文字透明度" VerticalAlignment="Center" Margin="0,6,0,0"
                                           ToolTip="浮窗文字的透明程度（30%–100%）" />
                                <DockPanel Grid.Row="10" Grid.Column="1" Margin="0,6,0,0">
                                    <TextBlock x:Name="TextOpacityLabel" DockPanel.Dock="Right" Width="56" TextAlignment="Right" Foreground="{DynamicResource TextSecondaryBrush}" />
                                    <Slider x:Name="TextOpacitySlider" Minimum="0.30" Maximum="1.0" Value="1.0"
                                            ValueChanged="OnFloatTextOpacityChanged" TickFrequency="0.05" IsSnapToTickEnabled="False" />
                                </DockPanel>
                            </Grid>
                        </GroupBox>

                        <TextBlock Style="{StaticResource SectionHeader}" Text="外观" />
                        <GroupBox Header="主题">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="ThemeLightRadio" Content="浅色模式" Checked="OnThemeChecked" Margin="0,0,20,0" />
                                <RadioButton x:Name="ThemeDarkRadio" Content="暗色模式" Checked="OnThemeChecked" />
                                <TextBlock Text="（浮窗/主窗口/编辑窗口/早报等全部界面即时生效）" FontSize="11.5"
                                           Margin="14,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource TextMutedBrush}" />
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="窗口背景" Margin="0,10,0,0">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton x:Name="BackdropMicaRadio" Content="云母" Checked="OnBackdropChecked" Margin="0,0,20,0" />
                                    <RadioButton x:Name="BackdropAcrylicRadio" Content="亚克力" Checked="OnBackdropChecked" Margin="0,0,20,0" />
                                    <RadioButton x:Name="BackdropSolidRadio" Content="纯色" Checked="OnBackdropChecked" />
                                </StackPanel>
                                <TextBlock FontSize="11.5" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,8,0,0"
                                           Text="云母 / 亚克力在 Windows 11 上效果最佳；纯色为浅色纯白、暗色纯黑，兼容性最好。" />
                            </StackPanel>
                        </GroupBox>

                        <TextBlock Style="{StaticResource SectionHeader}" Text="提醒" />
                        <GroupBox Header="新任务默认提醒方案">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" MinWidth="170" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Row="0" Grid.Column="0">
                                    <CheckBox x:Name="Rem7dCheck" Content="截止前第 7 天提醒一次" Checked="OnReminderDefaultChanged" Unchecked="OnReminderDefaultChanged" />
                                    <CheckBox x:Name="RemDailyCheck" Content="前 3 天起每天提醒" Margin="0,6,0,0" Checked="OnReminderDefaultChanged" Unchecked="OnReminderDefaultChanged" />
                                    <CheckBox x:Name="Rem24hCheck" Content="≤24 小时每 N 小时提醒" Margin="0,6,0,0" Checked="OnReminderDefaultChanged" Unchecked="OnReminderDefaultChanged" />
                                </StackPanel>
                                <StackPanel Grid.Row="0" Grid.Column="1">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="每日时间：" VerticalAlignment="Center" />
                                        <TextBox x:Name="DailyTimeBox" Width="76" TextChanged="OnReminderDefaultChanged" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                        <TextBlock Text="高频间隔：" VerticalAlignment="Center" />
                                        <ComboBox x:Name="FreqHoursCombo" Width="120" SelectionChanged="OnReminderDefaultChanged" />
                                    </StackPanel>
                                </StackPanel>

                                <TextBlock Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" FontSize="11.5" Foreground="{DynamicResource TextMutedBrush}"
                                           TextWrapping="Wrap" Margin="0,10,0,0"
                                           Text="逾期后：每天提醒一次，直到完成或删除（不可关闭）。" />
                            </Grid>
                        </GroupBox>

                        <TextBlock Style="{StaticResource SectionHeader}" Text="快捷键" />
                        <GroupBox Header="全局热键">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" MinWidth="170" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <CheckBox x:Name="HotkeyEnabledCheck" Grid.Row="0" Grid.Column="0"
                                          Content="启用快速添加热键" Checked="OnHotkeyEnabledChanged" Unchecked="OnHotkeyEnabledChanged" />
                                <TextBlock Grid.Row="0" Grid.Column="1" FontSize="11.5" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center"
                                           Text="默认 Ctrl+Alt+D；冲突时提示并可在此改键。" />
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="当前按键" VerticalAlignment="Center" Margin="0,8,0,0" />
                                <TextBox x:Name="HotkeyBox" Grid.Row="1" Grid.Column="1" Width="180" HorizontalAlignment="Left"
                                         Margin="0,8,0,0" IsReadOnly="True" Cursor="Hand"
                                         ToolTip="点击此框后按下新的组合键即可改键"
                                         PreviewMouseDown="OnHotkeyBoxMouseDown" PreviewKeyDown="OnHotkeyBoxKeyDown"
                                         LostKeyboardFocus="OnHotkeyBoxLostFocus" />
                            </Grid>
                        </GroupBox>

                        <TextBlock Style="{StaticResource SectionHeader}" Text="系统" />
                        <GroupBox Header="开机自启与早报">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" MinWidth="170" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <CheckBox x:Name="AutoStartCheck" Grid.Row="0" Grid.Column="0"
                                          Content="开机自启动" Checked="OnAutoStartChanged" Unchecked="OnAutoStartChanged" />
                                <TextBlock Grid.Row="0" Grid.Column="1" FontSize="11.5" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center"
                                           Text="写入 HKCU 当前用户 Run 键，无需管理员权限。" />
                                <CheckBox x:Name="MorningCheck" Grid.Row="1" Grid.Column="0" Margin="0,8,0,0"
                                          Content="启动时显示今日早报" Checked="OnMorningChanged" Unchecked="OnMorningChanged" />
                                <Button Grid.Row="1" Grid.Column="1" Content="立即显示早报" Width="130" HorizontalAlignment="Left"
                                        Margin="0,8,0,0" Click="OnShowMorningReport" />
                                <TextBlock Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" Margin="0,8,0,0" Text="数据文件" />
                                <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="0,8,0,0">
                                    <Button Content="打开数据目录" Margin="0,0,8,0" Click="OnOpenDataDir" />
                                    <TextBlock VerticalAlignment="Center" FontSize="11" Foreground="{DynamicResource TextMutedBrush}"
                                               Text="%AppData%\DDLSaver\data.json（自动备份 .bak）" />
                                </StackPanel>
                                <TextBlock Grid.Row="3" Grid.Column="0" VerticalAlignment="Center" Margin="0,8,0,0" Text="导入导出" />
                                <WrapPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Margin="0,8,0,0">
                                    <Button Content="导出 JSON" Margin="0,0,8,8" Click="OnExportJson" />
                                    <Button Content="导出 CSV" Margin="0,0,8,8" Click="OnExportCsv" />
                                    <Button Content="导入 JSON（合并）" Margin="0,0,8,8" Click="OnImportJsonMerge" />
                                    <Button Content="导入 JSON（替换）" Margin="0,0,8,8" Click="OnImportJsonReplace" />
                                    <Button Content="导入 .ics" Click="OnImportIcs" />
                                </WrapPanel>
                            </Grid>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <!-- 状态栏 -->
        <Border Grid.Row="3" Background="{DynamicResource ToolbarBgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="14,6">
            <DockPanel>
                <TextBlock x:Name="SaveTimeText" DockPanel.Dock="Right" Foreground="{DynamicResource TextMutedBrush}" FontSize="11" />
                <TextBlock x:Name="StatusText" Text="就绪" Foreground="{DynamicResource TextSecondaryBrush}" />
            </DockPanel>
        </Border>
    </Grid>
</ui:FluentWindow>
